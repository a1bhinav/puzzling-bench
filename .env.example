# Copy to .env (gitignored) and fill in. Nothing loads it automatically; export it with
#   set -a; source .env; set +a
# Never commit real keys.

# Model under test (scripts/run_eval.py, scripts/score.py): any OpenAI-compatible endpoint
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Fallbacks used by scripts/score.py when LLM_BASE_URL / LLM_API_KEY are unset
OPENAI_BASE_URL=
OPENAI_API_KEY=

# LLM judge (scripts/score.py, scripts/run_eval.py, scripts/extract_answers.py)
JUDGE_BASE_URL=
JUDGE_API_KEY=
JUDGE_MODEL=
# Optional JSON object merged into every judge request
JUDGE_EXTRA_BODY=
